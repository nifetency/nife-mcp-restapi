# REST API MCP Server Configuration
# Copy this file to .env and fill in your values

# REST API Base URL (REQUIRED)
# Example: https://api.example.com
REST_API_BASE_URL=https://api.example.com

# OpenAPI Specification URL (REQUIRED)
# Can be a URL to JSON/YAML or a local file path
# Examples: 
#   - https://api.example.com/openapi.json
#   - https://api.example.com/swagger.yaml
#   - ./specs/openapi.json
OPENAPI_SPEC_URL=https://api.example.com/openapi.json

# Authentication Type (optional)
# Options: bearer, apikey, basic, none
# Default: bearer
AUTH_TYPE=bearer

# Bearer Token Authentication (required if AUTH_TYPE=bearer)
API_ACCESS_TOKEN=your_access_token_here

# API Key Authentication (required if AUTH_TYPE=apikey)
API_KEY_HEADER=X-API-Key
API_KEY_VALUE=your_api_key_here

# Basic Authentication (required if AUTH_TYPE=basic)
BASIC_AUTH_USERNAME=username
BASIC_AUTH_PASSWORD=password

# Logging Level (optional)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Request Timeout (optional, in seconds)
# Default: 30
REQUEST_TIMEOUT=30

# Schema Cache TTL (optional, in seconds)
# How long to cache the OpenAPI schema before reloading
# Default: 3600 (1 hour)
SCHEMA_CACHE_TTL=3600

# Max Retries for failed requests (optional)
# Default: 3
MAX_RETRIES=3

# Retry Delay (optional, in seconds)
# Default: 1
RETRY_DELAY=1
