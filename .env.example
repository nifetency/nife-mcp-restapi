# REST API MCP Server Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# REST API Base URL (REQUIRED)
# Example: https://api.example.com
REST_API_BASE_URL=https://petstore.swagger.io/v2 

# OpenAPI Specification URL (REQUIRED)
# Can be a URL to JSON/YAML or a local file path
# Examples: 
#   - https://api.example.com/openapi.json
#   - https://api.example.com/swagger.yaml
#   - ./specs/openapi.json
OPENAPI_SPEC_URL= https://petstore.swagger.io/v2/swagger.json

# ============================================
# AUTHENTICATION (Choose one method)
# ============================================

# Authentication Type (optional)
# Options: bearer, apikey, basic, none
# Default: bearer
AUTH_TYPE=bearer

# Bearer Token Authentication (if AUTH_TYPE=bearer)
API_ACCESS_TOKEN=your_access_token_here

# API Key Authentication (if AUTH_TYPE=apikey)
# API_KEY_HEADER=X-API-Key
# API_KEY_VALUE=your_api_key_here

# Basic Authentication (if AUTH_TYPE=basic)
# BASIC_AUTH_USERNAME=username
# BASIC_AUTH_PASSWORD=password

# ============================================
# HTTP SERVER CONFIGURATION (Optional)
# ============================================

# Enable HTTP endpoint for health checks and metrics
# Default: true
ENABLE_HTTP_ENDPOINT=true

# Server port
# Default: 8080
MCP_SERVER_PORT=8080

# Server host
# Default: 0.0.0.0 (all interfaces)
MCP_SERVER_HOST=0.0.0.0

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# Request Timeout (in seconds)
# Default: 30
# REQUEST_TIMEOUT=30

# Schema Cache TTL (in seconds)
# How long to cache the OpenAPI schema before reloading
# Default: 3600 (1 hour)
# SCHEMA_CACHE_TTL=3600
